@model List<Tarea1.Models.Employee>

@{
    ViewData["Title"] = "Portal de Consulta de Recursos Humanos";
}

<form method="get" asp-action="Index">
    <div class="row mb-3">

        <div class="col-md-3">
            <label class="form-label">Name</label>
            <input type="text" name="name" value="@ViewBag.Name" class="form-control" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Department</label>
            <select name="department" class="form-select">
                <option value="">All</option>
                @foreach (var dep in ViewBag.Departments)
                {
                    if (dep == ViewBag.Department)
                    {
                        <option value="@dep" selected>@dep</option>
                    }
                    else
                    {
                        <option value="@dep">@dep</option>
                    }
                }
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label">Job Title</label>
            <input type="text" name="jobTitle" value="@ViewBag.JobTitle" class="form-control" />
        </div>

        <div class="col-md-2">
            <label class="form-label">Shift</label>
            <select name="shift" class="form-select">
                <option value="">All</option>
                @foreach (var sh in ViewBag.Shifts)
                {
                    if (sh == ViewBag.Shift)
                    {
                        <option value="@sh" selected>@sh</option>
                    }
                    else
                    {
                        <option value="@sh">@sh</option>
                    }
                }
            </select>
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">Search</button>
        </div>

    </div>
</form>

<div class="container mt-4">

    <h2 class="mb-4">HR Consultation Portal - AdventureWorks</h2>

    <div class="card shadow-sm">
        <div class="card-header">
            <strong>Results</strong>
        </div>
        <div class="card-body">

            @if (Model == null || Model.Count == 0)
            {
                <div class="alert alert-warning">No employees found.</div>
            }
            else
            {
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Full Name</th>
                            <th>Job Title</th>
                            <th>Department</th>
                            <th>Shift</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var emp in Model)
                        {
                            <tr>
                                <td>@emp.BusinessEntityID</td>
                                <td>@emp.FullName</td>
                                <td>@emp.JobTitle</td>
                                <td>@emp.DepartmentName</td>
                                <td>@emp.ShiftName</td>
                                <td>
                                    @if (emp.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

        </div>
    </div>
</div>